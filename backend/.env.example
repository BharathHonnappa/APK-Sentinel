# APK Sentinel - Environment Variables
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
GROQ_API_KEY=your_groq_api_key_here
VIRUSTOTAL_LOOKUP_ENABLED=false
VIRUSTOTAL_API_KEY=
MAX_APK_SIZE_MB=100
ANALYSIS_TIMEOUT_SECONDS=900
UPLOAD_DIR=./uploads
ANALYSIS_DIR=./analysis_data
CORS_ORIGINS=["http://localhost:5173"]
DYNAMIC_ANALYSIS_ENABLED=false
DYNAMIC_ANALYSIS_BASE_URL=
DYNAMIC_ANALYSIS_API_KEY=
MOBSF_API_KEY=  # Keep equal to DYNAMIC_ANALYSIS_API_KEY for the local service
DYNAMIC_ANALYSIS_TIMEOUT=900
DYNAMIC_ANALYSIS_MAX_RUNTIME=120
DYNAMIC_ANALYSIS_MAX_CONCURRENT_JOBS=1
DYNAMIC_ANALYSIS_DEVICE_ID=
STATIC_SCORE_WEIGHT=0.75
DYNAMIC_SCORE_WEIGHT=0.25



# Private runtime-analysis service and shared API key.
# Dynamic analysis remains disabled until a supported Android device is connected.
# DYNAMIC_ANALYSIS_ENABLED=true
# DYNAMIC_ANALYSIS_BASE_URL=http://mobsf:8000
# DYNAMIC_ANALYSIS_API_KEY=627fba2f1a0b0f5c306249e3fddaf5a7ef29db64ab01a3a12c2154e15a1be5ae
# MOBSF_API_KEY=627fba2f1a0b0f5c306249e3fddaf5a7ef29db64ab01a3a12c2154e15a1be5ae
# DYNAMIC_ANALYSIS_TIMEOUT=900
# DYNAMIC_ANALYSIS_MAX_RUNTIME=120
# DYNAMIC_ANALYSIS_MAX_CONCURRENT_JOBS=1
# DYNAMIC_ANALYSIS_DEVICE_ID=emulator-5554
# # Android Studio Emulator is running on the host; MobSF uses the host ADB server.
# ADB_SERVER_SOCKET=tcp:192.168.7.1:5037
# MOBSF_ANALYZER_IDENTIFIER=emulator-5554

